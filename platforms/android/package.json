{
  "name": "accordeur-android",
  "version": "1.9.0",
  "private": true,
  "description": "Accordeur — édition tablette Android (Capacitor)",
  "scripts": {
    "prepare-app": "node ../../tools/build.js android --out . && node patch-project.js assets",
    "add-android": "npx cap add android && node patch-project.js manifest",
    "sync": "node ../../tools/build.js android --out . && npx cap sync android && node patch-project.js manifest",
    "apk": "node build-apk.js debug",
    "apk:offline": "node build-apk.js debug --offline --no-sync",
    "apk:release": "node build-apk.js release"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2"
  }
}
