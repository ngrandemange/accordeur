{
  "name": "accordeur-desktop",
  "version": "1.9.0",
  "private": true,
  "description": "Accordeur — édition PC",
  "author": "Accordeur",
  "main": "main.js",
  "scripts": {
    "prepare-app": "node prepare.js",
    "start": "node prepare.js && electron .",
    "dist": "node prepare.js && electron-builder --publish never",
    "dist:win": "node prepare.js && electron-builder --win --publish never",
    "dist:mac": "node prepare.js && electron-builder --mac --publish never",
    "dist:linux": "node prepare.js && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.accordeur.desktop",
    "productName": "Accordeur",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "appfiles.js",
      "www/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Accordeur écoute votre instrument pour l'accorder.",
        "NSCameraUsageDescription": "Accordeur prend en photo une partition pour la lire."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Audio",
      "icon": "build/icon.png",
      "maintainer": "Accordeur"
    },
    "artifactName": "Accordeur-${version}-${os}-${arch}.${ext}"
  }
}
