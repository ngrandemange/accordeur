{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(node test.js)",
      "Bash(node tests/omr-check.js)",
      "Bash(node tools/build.js:*)",
      "Bash(npm run apk)",
      "Bash(npm run apk:offline)",
      "Bash(npm run dist:win)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(git tag:*)",
      "Read(./.env)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)"
    ]
  }
}
